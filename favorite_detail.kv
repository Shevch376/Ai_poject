<FavoriteCardRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(112)
    spacing: dp(12)
    padding: [dp(14), dp(12)]
    radius: [dp(18)]
    md_bg_color: app.surface_strong_color
    canvas.before:
        Color:
            rgba: app.surface_strong_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: self.radius
        Color:
            rgba: app.card_border_color
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, dp(18)]
            width: 1
    AsyncImage:
        size_hint: None, None
        size: (dp(64), dp(78)) if root.has_image else (0, 0)
        source: root.image_url if root.has_image else ""
        opacity: 1 if root.has_image else 0
        allow_stretch: True
        keep_ratio: False
        canvas.before:
            Color:
                rgba: app.surface_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(14)]
    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(4)
        MDLabel:
            text: root.title
            theme_text_color: "Custom"
            text_color: app.primary_text_color
            font_size: sp(15)
            bold: True
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None
            shorten: True
        MDLabel:
            text: root.subtitle
            theme_text_color: "Custom"
            text_color: app.card_subtitle_color
            font_size: sp(11.5)
            size_hint_y: None
            height: self.texture_size[1] if self.text else 0
            text_size: self.width, None
            shorten: True
        MDLabel:
            text: root.description
            theme_text_color: "Custom"
            text_color: app.card_subtitle_color
            font_size: sp(11)
            size_hint_y: None
            height: min(self.texture_size[1], dp(18)) if self.text else 0
            max_lines: 1
            text_size: self.width, None
            shorten: True
        Widget:
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: self.minimum_height
            MDLabel:
                text: root.meta_left
                theme_text_color: "Custom"
                text_color: app.card_meta_text_color
                font_size: sp(11)
                size_hint_y: None
                height: self.texture_size[1] if self.text else 0
            MDLabel:
                text: root.meta_right
                theme_text_color: "Custom"
                text_color: app.card_meta_text_color
                font_size: sp(11)
                halign: "right"
                size_hint_y: None
                height: self.texture_size[1] if self.text else 0

<FavoriteDetailScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.app_bar_bg_color
        padding: [dp(16), dp(18), dp(16), dp(18)]
        spacing: dp(16)

        MDBoxLayout:
            size_hint_y: None
            height: dp(42)
            MDFloatLayout:
                size_hint_x: 1
                MDFloatLayout:
                    size_hint: None, None
                    size: dp(40), dp(40)
                    pos_hint: {"x": 0, "center_y": 0.5}
                    canvas.before:
                        Color:
                            rgba: app.surface_color
                        Ellipse:
                            pos: self.pos
                            size: self.size
                    Button:
                        size: self.parent.size
                        pos: self.parent.pos
                        size_hint: None, None
                        background_color: 0, 0, 0, 0
                        background_normal: ""
                        background_down: ""
                        on_release: root.go_back()
                    MDIcon:
                        icon: "chevron-left"
                        theme_text_color: "Custom"
                        text_color: app.primary_text_color
                        font_size: dp(20)
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                MDLabel:
                    text: "Saved Card"
                    halign: "center"
                    font_size: sp(21)
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.primary_text_color
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}

        ScrollView:
            bar_width: 0
            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(16)
                AsyncImage:
                    size_hint_y: None
                    height: dp(220) if root.has_image else 0
                    source: root.image_url if root.has_image else ""
                    opacity: 1 if root.has_image else 0
                    allow_stretch: True
                    keep_ratio: False
                    canvas.before:
                        Color:
                            rgba: app.surface_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(24)]
                MDLabel:
                    text: root.title_text
                    theme_text_color: "Custom"
                    text_color: app.primary_text_color
                    bold: True
                    font_size: sp(22)
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                MDLabel:
                    text: root.subtitle_text
                    theme_text_color: "Custom"
                    text_color: 0.45, 0.72, 1, 1
                    font_size: sp(14)
                    size_hint_y: None
                    height: self.texture_size[1] if self.text else 0
                    text_size: self.width, None
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(12)
                    MDLabel:
                        text: root.meta_left
                        theme_text_color: "Custom"
                        text_color: 0.82, 0.84, 0.88, 1
                        font_size: sp(12)
                        size_hint_y: None
                        height: self.texture_size[1] if self.text else 0
                    MDLabel:
                        text: root.meta_right
                        theme_text_color: "Custom"
                        text_color: 0.82, 0.84, 0.88, 1
                        font_size: sp(12)
                        halign: "right"
                        size_hint_y: None
                        height: self.texture_size[1] if self.text else 0
                MDLabel:
                    text: root.accent_text
                    theme_text_color: "Custom"
                    text_color: 0.54, 0.87, 0.67, 1 if self.text else 0
                    font_size: sp(12)
                    size_hint_y: None
                    height: self.texture_size[1] if self.text else 0
                MDLabel:
                    text: root.body_text
                    theme_text_color: "Custom"
                    text_color: 0.82, 0.84, 0.88, 1
                    font_size: sp(14)
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                MDLabel:
                    text: root.load_status
                    theme_text_color: "Custom"
                    text_color: 0.91, 0.45, 0.45, 1
                    font_size: sp(11.5)
                    size_hint_y: None
                    height: self.texture_size[1] if self.text else 0
                    text_size: self.width, None
                MDLabel:
                    text: "Similar picks"
                    theme_text_color: "Custom"
                    text_color: app.primary_text_color
                    bold: True
                    font_size: sp(17)
                    size_hint_y: None
                    height: self.texture_size[1] if root.related_items else 0
                    opacity: 1 if root.related_items else 0
                MDLabel:
                    text: root.related_status
                    theme_text_color: "Custom"
                    text_color: 0.91, 0.45, 0.45, 1
                    font_size: sp(11.5)
                    size_hint_y: None
                    height: self.texture_size[1] if self.text else 0
                    text_size: self.width, None
                MDBoxLayout:
                    id: related_items_box
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(12)
