<HobbyButton@ToggleButton>:
    text: ""
    icon_name: ""
    color: 1, 1, 1, 0
    size_hint_y: None
    height: dp(52)
    background_color: 0, 0, 0, 0
    group: "hobbies"
    font_size: sp(15)
    bold: True
    canvas.before:
        Color:
            rgba: app.selected_chip_color if self.state == "down" else app.surface_color
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [dp(16)]
    AnchorLayout:
        pos: root.pos
        size: root.size
        anchor_x: "center"
        anchor_y: "center"
        MDBoxLayout:
            adaptive_width: True
            orientation: "horizontal"
            spacing: dp(10)
            size_hint: None, None
            height: dp(20)
            MDIcon:
                icon: root.icon_name
                size_hint: None, None
                size: dp(18), dp(18)
                theme_text_color: "Custom"
                text_color: app.selected_chip_text_color if root.state == "down" else app.primary_text_color
                font_size: dp(18)
                pos_hint: {"center_y": 0.5}
            MDLabel:
                text: root.text
                adaptive_size: True
                theme_text_color: "Custom"
                text_color: app.selected_chip_text_color if root.state == "down" else app.primary_text_color
                font_size: sp(15)
                bold: True
                pos_hint: {"center_y": 0.5}

<HobbiesScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.app_bg_color
        padding: [dp(26), 0, dp(26), 0]

        Widget:
            size_hint_y: None
            height: dp(28)

        MDFloatLayout:
            size_hint: None, None
            size: dp(40), dp(40)
            pos_hint: {"x": 0}
            canvas.before:
                Color:
                    rgba: app.surface_color
                Ellipse:
                    pos: self.pos
                    size: self.size
            Button:
                size: root.size
                pos: root.pos
                size_hint: None, None
                background_color: 0, 0, 0, 0
                background_normal: ""
                background_down: ""
                on_release:
                    app.animate_progress(4)
                    app.switch_screen("focus_screen", "right")
            MDIcon:
                icon: "chevron-left"
                theme_text_color: "Custom"
                text_color: app.primary_text_color
                font_size: dp(21)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Widget:
            size_hint_y: None
            height: dp(18)

        Widget:
            size_hint_y: None
            height: dp(3)
            canvas.before:
                Color:
                    rgba: app.divider_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(3)]
                Color:
                    rgba: 0.102, 0.451, 0.914, 1
                RoundedRectangle:
                    pos: self.pos
                    size: (app.progress_width, self.height)
                    radius: [dp(3)]

        Widget:
            size_hint_y: None
            height: dp(26)

        MDLabel:
            text: "Select your hobby"
            font_size: sp(28)
            bold: True
            theme_text_color: "Custom"
            text_color: app.primary_text_color
            halign: "left"
            size_hint_y: None
            height: self.texture_size[1]

        Widget:
            size_hint_y: None
            height: dp(10)

        MDLabel:
            text: "What do you enjoy doing the most?"
            font_size: sp(14)
            theme_text_color: "Custom"
            text_color: app.muted_text_color
            halign: "left"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None
            line_height: 1.35

        Widget:
            size_hint_y: None
            height: dp(28)

        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(10)
            HobbyButton:
                text: "Sports & Fitness"
                icon_name: "dumbbell"
                state: "down" if root.selected_hobby == "sports" else "normal"
                on_release: root.selected_hobby = "sports"
            HobbyButton:
                text: "Music & Arts"
                icon_name: "palette-outline"
                state: "down" if root.selected_hobby == "arts" else "normal"
                on_release: root.selected_hobby = "arts"
            HobbyButton:
                text: "Gaming & Tech"
                icon_name: "controller-classic-outline"
                state: "down" if root.selected_hobby == "gaming" else "normal"
                on_release: root.selected_hobby = "gaming"
            HobbyButton:
                text: "Cooking & Food"
                icon_name: "silverware-fork-knife"
                state: "down" if root.selected_hobby == "food" else "normal"
                on_release: root.selected_hobby = "food"

        Widget:
            size_hint_y: 1

        Button:
            size_hint: 1, None
            height: dp(54)
            background_color: 0, 0, 0, 0
            on_release: if root.selected_hobby: app.switch_screen("activity_screen", "left")
            canvas.before:
                Color:
                    rgba: app.selected_chip_color if root.selected_hobby else app.disabled_surface_color
                RoundedRectangle:
                    size: self.size
                    pos: self.pos
                    radius: [dp(20)]
            MDRelativeLayout:
                pos: self.parent.pos if self.parent else (0, 0)
                size: self.parent.size if self.parent else (0, 0)
                MDLabel:
                    text: "Continue"
                    halign: "center"
                    bold: True
                    font_size: sp(16)
                    theme_text_color: "Custom"
                    text_color: app.selected_chip_text_color if root.selected_hobby else app.muted_text_color
                    pos_hint: {"center_x": .5, "center_y": .5}

        Widget:
            size_hint_y: None
            height: dp(56)
