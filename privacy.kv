<PrivacyScreen>:
    md_bg_color: app.app_bar_bg_color

    RelativeLayout:
        MDBoxLayout:
            orientation: 'vertical'
            padding: [dp(20), dp(16), dp(20), dp(24)]
            spacing: dp(20)

            MDFloatLayout:
                size_hint_y: None
                height: dp(40)
                MDIconButton:
                    icon: "chevron-left"
                    size_hint: None, None
                    size: dp(40), dp(40)
                    icon_size: dp(18)
                    theme_text_color: "Custom"
                    text_color: app.primary_text_color
                    md_bg_color: app.surface_color
                    pos_hint: {"x": 0, "center_y": 0.5}
                    on_release: app.switch_screen("profile", "right")

            Widget:
                size_hint_y: None
                height: dp(12)

            MDLabel:
                text: "Privacy & Permissions"
                font_size: sp(22)
                bold: True
                theme_text_color: "Custom"
                text_color: app.primary_text_color
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]

            MDBoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)

                PrivacyItem:
                    text: "Location"
                    icon: "map-marker-outline"
                PrivacyItem:
                    text: "Notifications"
                    icon: "bell-outline"
                PrivacyItem:
                    text: "Private mode"
                    icon: "incognito"

                Widget:
                    size_hint_y: None
                    height: dp(20)

                # Clear history РІ С†РІРµС‚Рµ 0.102, 0.114, 0.122
                Button:
                    size_hint_y: None
                    height: dp(56)
                    background_color: 0, 0, 0, 0
                    on_release: print("Clear History")
                    canvas.before:
                        Color:
                            rgba: app.surface_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

                    MDBoxLayout:
                        pos: self.parent.pos
                        size: self.parent.size
                        padding: [dp(20), 0]
                        spacing: dp(15)
                        MDIcon:
                            icon: "delete-outline"
                            theme_text_color: "Custom"
                            text_color: app.primary_text_color
                            size_hint: None, None
                            size: dp(24), dp(24)
                            font_size: dp(20)
                            pos_hint: {"center_y": .5}
                        MDLabel:
                            text: "Clear history"
                            theme_text_color: "Custom"
                            text_color: app.primary_text_color
                            font_size: sp(16)
                            pos_hint: {"center_y": .5}

            Widget:

            Button:
                text: "Save change"
                size_hint_y: None
                height: dp(56)
                background_color: 0, 0, 0, 0
                font_size: sp(16)
                bold: True
                color: 1, 1, 1, 1
                on_release: app.switch_screen("profile", "right")
                canvas.before:
                    Color:
                        rgba: 0.102, 0.451, 0.910, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(14)]

<PrivacyItem>:
    active: False
    size_hint_y: None
    height: dp(56)
    padding: [dp(16), 0]
    canvas.before:
        Color:
            rgba: app.surface_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]

    MDIcon:
        icon: root.icon
        size_hint: None, None
        size: dp(24), dp(24)
        theme_text_color: "Custom"
        text_color: app.primary_text_color
        pos_hint: {"center_y": .5}
        font_size: dp(20)

    MDLabel:
        text: root.text
        theme_text_color: "Custom"
        text_color: app.primary_text_color
        font_size: sp(16)
        pos_hint: {"center_y": .5}
        padding: [dp(10), 0]

    MDBoxLayout:
        size_hint: None, None
        size: dp(42), dp(22)
        pos_hint: {"center_y": .5}

        Button:
            background_color: 0, 0, 0, 0
            on_release: root.active = not root.active
            canvas.before:
                Color:
                    rgba: (0.102, 0.451, 0.910, 1) if root.active else (0.627, 0.643, 0.659, 0.6)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [self.height/2]
                Color:
                    rgba: 1, 1, 1, 1
                Ellipse:
                    pos: (self.x + self.width - self.height + dp(2), self.y + dp(2)) if root.active else (self.x + dp(2), self.y + dp(2))
                    size: (self.height - dp(4), self.height - dp(4))
